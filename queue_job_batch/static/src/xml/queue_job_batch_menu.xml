<?xml version="1.0" encoding="UTF-8" ?>
<templates>

    <t t-name="queue_job_batch.QueueJobBatchMenuView" owl="1">
        <div class="o_ActivityMenuView dropdown o_job_batch_navbar_item" t-ref="root">
            <a
                class="o_ActivityMenuView_dropdownToggle dropdown-toggle o-no-caret o-dropdown--narrow"
                title="Job batches"
                t-att-aria-expanded="state.isOpen ? 'true' : 'false'"
                href="#"
                role="button"
                t-on-click="onClickDropdownToggle"
            >
                <i class="fa fa-list" role="img" aria-label="Job batches" />
                <span
                    t-if="counter > 0"
                    class="o_ActivityMenuView_counter badge"
                    t-esc="counter"
                />
            </a>
            <div
                t-if="state.isOpen"
                class="o_ActivityMenuView_dropdownMenu o-dropdown-menu dropdown-menu-end show bg-view"
                role="menu"
            >
                <div
                    class="border-bottom d-flex flex-shrink-0"
                    t-if="counter > 0"
                >
                    <button class="o-desktop btn btn-link o-active fw-bolder" type="button">
                        Job Batches
                    </button>
                    <div class="flex-grow-1" />
                    <button
                        class="btn btn-link"
                        type="button"
                        t-on-click="viewAll"
                    >View All</button>
                </div>
                <t t-if="state.batches.length === 0">
                    <div class="o_ActivityMenuView_activityGroups">
                        <div
                            class="o_ActivityMenuView_noActivity dropdown-item-text text-center d-flex justify-content-center"
                        >
                            <span>No jobs to view.</span>
                        </div>
                    </div>
                </t>
                <div
                    t-if="state.batches.length > 0"
                    class="row"
                    style="width:100%"
                >
                    <t
                        t-foreach="state.batches"
                        t-as="batch"
                        t-key="batch.id"
                        name="activityGroupLoop"
                    >
                        <div class="col-2 m-2" t-on-click="() => onClickBatch(batch)">
                            <span
                                class="fa fa-list fa-3x o_job_queue_failed"
                                t-if="batch.failed_job_count > 0"
                            />
                            <span
                                class="fa fa-list fa-3x o_job_queue_finished"
                                t-elif="batch.finished_job_count == batch.job_count"
                            />
                            <span class="fa fa-list fa-3x o_job_queue_progress" t-else="" />
                        </div>
                        <div class="col-8" t-on-click="() => onClickBatch(batch)">
                            <strong
                                class="o_NotificationListItem_name o_NotificationGroup_name text-truncate"
                            >
                                <t t-esc="batch.name" />
                            </strong>
                            <div class="progress">
                                <div
                                    class="progress-bar o_queue_job_finished_progressbar"
                                    role="progressbar"
                                    t-att-style="'width: ' + (100 * batch.completeness) + '%'"
                                    t-att-aria-valuenow="100 * batch.completeness"
                                />
                                <div
                                    class="progress-bar o_queue_job_failed_progressbar"
                                    role="progressbar"
                                    t-att-style="'width: ' + (100 * batch.failed_percentage) + '%'"
                                    t-att-aria-valuenow="100 * batch.failed_percentage"
                                />
                            </div>
                            <span
                                t-out="batch.finished_job_count + '/' + batch.failed_job_count + '/' + batch.job_count"
                            />
                        </div>
                        <div class="col-1 mt-3" t-on-click="() => onHideBatch(batch)">
                            <span
                                t-if="batch.state === 'finished'"
                                title="Mark as Read"
                                class="fa fa-check"
                            />
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
